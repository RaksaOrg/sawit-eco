{
  "name": "sawit-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mobile:dev": "npm --prefix apps/mobile run start",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:build:debug": "npm --prefix apps/mobile run build:android:debug",
    "mobile:build:release": "npm --prefix apps/mobile run build:android:release",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "web:install": "npm --prefix apps/web install",
    "web:start": "npm --prefix apps/web run start",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "db:push": "npm --prefix apps/web run db:push",
    "db:seed": "npm --prefix apps/web run db:seed",
    "db:studio": "npm --prefix apps/web run db:studio",
    "typecheck": "npm --prefix apps/web run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "lint:fix": "npm --prefix apps/web run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --prefix apps/web run test && npm --prefix packages/contracts run test && npm --prefix packages/vision run test",
    "test:coverage": "npm --prefix apps/web run test:coverage && npm --prefix apps/mobile run test:coverage",
    "test:vision": "npm --prefix packages/vision run test",
    "quality": "npm run check:language && npm run typecheck && npm run contracts:typecheck && npm run vision:typecheck && npm run mobile:typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run contracts:test:coverage && npm run test:vision && npm run mobile:test",
    "check:language": "node .opencode/scripts/check-language.mjs",
    "vision:compare": "npm --prefix packages/vision run compare",
    "vision:clipboard": "npm --prefix packages/vision run clipboard",
    "vision:extract": "npm --prefix packages/vision run extract",
    "vision:frames": "npm --prefix packages/vision run frames",
    "vision:scenes": "npm --prefix packages/vision run scenes",
    "vision:transcribe": "npm --prefix packages/vision run transcribe",
    "vision:typecheck": "npm --prefix packages/vision run typecheck",
    "contracts:install": "npm --prefix packages/contracts install",
    "contracts:typecheck": "npm --prefix packages/contracts run typecheck",
    "contracts:test": "npm --prefix packages/contracts run test",
    "contracts:test:coverage": "npm --prefix packages/contracts run test:coverage",
    "precommit": "npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
