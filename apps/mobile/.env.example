# ============================================================
# SawitEco (Mobile) — Environment Variables
# Copy to .env or .env.local
# ============================================================

# Base URL to the web backend API (e.g. http://10.0.2.2:3000 for Android emulator,
# http://localhost:3000 for iOS simulator, or your LAN IP for physical device)
NODE_ENV=development
EXPO_PUBLIC_API_URL="http://192.168.1.3:3000"
