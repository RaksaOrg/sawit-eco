    "@ui5/webcomponents-react": "^2.28.1",
    "@sawit/contracts": "file:../../packages/contracts",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "openai": "^7.45.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "recharts": "^2.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
