  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@ui5/webcomponents": "^2.28.1",
    "@ui5/webcomponents-fiori": "^2.28.1",
