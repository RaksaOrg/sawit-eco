NODE_ENV=development

# ============================================================
# Sawit Ecosystem — Environment Variables
# Copy to .env (dev) or set in your hosting provider (prod)
# ============================================================

# ── Database ────────────────────────────────────────────────
# Local: postgresql://sawitecosystem:sawitecosystem@localhost:5433/sawitecosystem
# Supabase (Session Pooler / Port 5432): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Supabase (Transaction Pooler / Port 6543): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://sawitecosystem:sawitecosystem@localhost:5433/sawitecosystem"

# ── Auth ────────────────────────────────────────────────────
# Required in production. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Optional: default tenant for local debug only.
# Do not set in production multi-tenant deployments.
TENANT_ID=""

# ── WhatsApp Cloud API (Meta) ───────────────────────────────
# https://developers.facebook.com/apps
WA_VERIFY_TOKEN=""
WA_ACCESS_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_APP_SECRET=""

# ── Meta Model API / Partner Inference Key ─────────────────
# Satu kunci otentikasi untuk semua model Meta (Reasoning, Vision, SAM, ASR).
# Dapatkan dari:
# - Meta Model API: https://dev.meta.ai (Bearer API key)
# - Partner: Baseten (sec_...), Fireworks (fw_...), Modal, atau Ollama ("ollama-local")
META_API_KEY=""

# ── 1. Meta Reasoning (Supply Chain, HRIS, General Agent) ──
# Opsi A - Meta Model API resmi:
#   META_INFERENCE_ENDPOINT="https://api.meta.ai/v1/chat/completions"
#   META_MODEL="muse-spark-1.3"  # atau "muse-wonder-1.0", "muse-spark-1.3-contributor"
# Opsi B - Open-weights via Fireworks:
#   META_INFERENCE_ENDPOINT="https://api.fireworks.ai/inference/v1/chat/completions"
#   META_MODEL="accounts/fireworks/models/llama-v3p3-70b-instruct"
# Opsi C - Open-weights via Baseten / Modal:
#   META_INFERENCE_ENDPOINT="https://model-xxxx.api.baseten.co/production/predict"
#   META_MODEL="meta-llama/Llama-3.3-70B-Instruct"
# Opsi D - Local Ollama (docker compose up -d ollama):
#   META_INFERENCE_ENDPOINT="http://localhost:11434/v1/chat/completions"
#   META_MODEL="llama3.2"  # atau "llama3.3"
META_INFERENCE_ENDPOINT=""
META_MODEL="meta-llama/Llama-3.3-70B-Instruct"
META_INFERENCE_TIMEOUT_MS="30000"

# ── 2. Meta Vision (Analisis Visual Daun, Buah, & Gulma) ────
# Opsi A - Meta Model API resmi (multimodal text + image):
#   VISION_INFERENCE_ENDPOINT="https://api.meta.ai/v1/chat/completions"
#   VISION_MODEL="muse-spark-1.3"  # atau "muse-wonder-1.0"
# Opsi B - Open-weights via Fireworks / Baseten:
#   VISION_INFERENCE_ENDPOINT="https://api.fireworks.ai/inference/v1/chat/completions"
#   VISION_MODEL="meta-llama/Llama-3.2-90B-Vision-Instruct"
# Opsi C - Local Ollama:
#   VISION_INFERENCE_ENDPOINT="http://localhost:11434/v1/chat/completions"
#   VISION_MODEL="llama3.2-vision"
# Jika dikosongkan, otomatis memakai META_INFERENCE_ENDPOINT & META_MODEL.
VISION_INFERENCE_ENDPOINT=""
VISION_MODEL="meta-llama/Llama-3.2-90B-Vision-Instruct"
VISION_TIMEOUT_MS="30000"

# ── 3. Meta SAM 3.1 (Segment Anything Model) ───────────────
# Segmentasi lesi penyakit daun dan penghitungan janjang TBS.
# Opsi A - Meta Model API resmi (Responses API protocol):
#   SAM_INFERENCE_ENDPOINT="https://api.meta.ai/v1/responses"
#   SAM_MODEL="sam-3.1"
# Opsi B - Self-hosted / Baseten container:
#   SAM_INFERENCE_ENDPOINT="https://model-xxxx.api.baseten.co/production/predict"
#   SAM_MODEL="meta/sam-3.1-segment-anything"
# Jika dikosongkan, sistem berjalan otomatis dalam mode simulasi zero-shot deterministik.
SAM_INFERENCE_ENDPOINT=""
SAM_MODEL="sam-3.1"
SAM_TIMEOUT_MS="60000"

# ── 4. Meta Speech to Text (ASR) ────────────────────────────
# Transkripsi voice note WhatsApp dan rekaman suara aplikasi mobile.
# Opsi A - Meta Model API resmi (file endpoint):
#   ASR_INFERENCE_ENDPOINT="https://api.meta.ai/v1/asr/transcribe"
#   ASR_MODEL="muse-voice-transcribe-1.0"
# Audio non-WAV dikonversi ke WAV mono PCM 24 kHz sebelum request.
# ffmpeg harus tersedia di PATH atau FFMPEG_PATH menunjuk executable.
FFMPEG_PATH=""
ASR_INFERENCE_ENDPOINT="https://api.meta.ai/v1/asr/transcribe"
ASR_MODEL="muse-voice-transcribe-1.0"

# ── 5. Secondary Failover (OpenAI - Opsional) ───────────────
# Hanya dipanggil jika inferensi Meta tidak dikonfigurasi atau mengalami kegagalan total.
OPENAI_API_KEY=""

# ── 6. Cache / Queue (Opsional) ─────────────────────────────
# Redis untuk buffering lonjakan traffic webhook WhatsApp di musim panen raya.
REDIS_URL=""

# ── 7. Kebijakan Persetujuan Pengadaan ──────────────────────
# Pesanan sarana produksi di atas batas Manager membutuhkan approval Owner di Fiori.
DEFAULT_APPROVAL_THRESHOLD_IDR="5000000"
MANAGER_APPROVAL_LIMIT_IDR="2000000"

# ── 8. Shortcut Login Demo (Local only) ─────────────────────
# Tampilkan tombol login cepat per-tenant pada /login. Wajib set "0" di production!
DEMO_LOGIN_ENABLED="1"

# ── Mock Models (Development / Offline Demo) ─────────────
# Set "1" untuk mengaktifkan mock model deterministik tanpa META_API_KEY.
# Reasoning, Vision, SAM, dan ASR akan mengembalikan data mock tanpa HTTP call.
MOCK_MODELS_ENABLED="0"
