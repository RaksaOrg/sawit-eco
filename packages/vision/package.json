{
  "name": "@sawit/vision",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "compare": "node --import tsx ./cli.mts",
    "extract": "node --import tsx ./cli.mts extract",
    "frames": "node --import tsx ./cli.mts frames",
    "scenes": "node --import tsx ./cli.mts scenes",
    "transcribe": "node --import tsx ./cli.mts transcribe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "clipboard": "node --import tsx ./cli.mts clipboard",
    "test:coverage": "jest --coverage",
    "precommit": "npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
